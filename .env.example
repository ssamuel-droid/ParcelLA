# ─────────────────────────────────────────────────────────────────────────────
# ParceLLA — Environment Variables
# Copy to .env — never commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── FREE: Supabase (database + auth) ─────────────────────────────────────────
# https://supabase.com → new project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5c...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5c...
GOOGLE_AUTH_ENABLED=false

# ── Google Maps Platform ──────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs → Enable:
#   Maps JavaScript API, Geocoding API, Street View Static API
# Free tier: $200/mo credit (~28K map loads free)
# One key covers all three APIs
GOOGLE_MAPS_API_KEY=AIzaSy...
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...   # same key — used in frontend build

# ── FREE: LA City Open Data (Socrata) ────────────────────────────────────────
# https://data.lacity.org/profile/edit/developer_settings
# Without token: 1,000 req/day. With token: unlimited.
SOCRATA_APP_TOKEN=

# ── FREE: US Census Bureau ────────────────────────────────────────────────────
# https://api.census.gov/data/key_signup.html
# Unlocks: ACS demographics, median income, renter % by tract
CENSUS_API_KEY=

# ── Anthropic Claude API (AI deal narratives) ────────────────────────────────
# https://console.anthropic.com → API Keys
# Pay-as-you-go: ~$0.01 per narrative
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Resend (email — $0 for 3K/mo) ────────────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Stripe (property unlocks and subscriptions) ─────────────────────────────
# https://dashboard.stripe.com → Developers → API Keys
# Use sk_test_xxx for testing, sk_live_xxx for production
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
# Prices are created inline by Checkout: $10/property and $49/month.
# Enable Cards and ACH Direct Debit in Stripe payment-method settings.
APP_URL=https://parcel-la.vercel.app

# Enable only after running supabase/migrations/019_terms_acceptance_audit.sql.
TERMS_ENFORCEMENT_ENABLED=false

# ── RentCast (market comps plus cached owner/sale records) ───────────────────
# https://app.rentcast.io/app/api
RENTCAST_API_KEY=
# Detail views use at most one property-record request per address every 30 days.
# The daily ceiling applies across the app; set the enabled flag to false to stop
# all on-demand owner/sale calls without removing the key.
RENTCAST_LIVE_OWNER_LOOKUPS_ENABLED=true
RENTCAST_OWNER_DAILY_LIMIT=25
OWNER_DATA_CACHE_DAYS=30
# Negative RentCast results are cached briefly to avoid repeat paid calls while
# still allowing incomplete provider records to be retried the next day.
OWNER_MISS_CACHE_HOURS=24
# Monthly cache controls. The GitHub Action runs on the 1st of each month and
# pulls market comps by zip, plus a small number of site-specific records.
PROPERTY_ENRICH_SITE_LIMIT=5
PROPERTY_ENRICH_MARKET_LIMIT=500
PROPERTY_ENRICH_STALE_DAYS=30
PROPERTY_ENRICH_MAX_RENTCAST_CALLS=50

# ── ATTOM (recorded owner and original mortgage data; optional) ──────────────
# https://api.developer.attomdata.com/
# Detail views call ATTOM only when the 30-day cache lacks a mortgage. The
# monthly job also rotates through a capped set of sites.
ATTOM_API_KEY=
ATTOM_LIVE_MORTGAGE_LOOKUPS_ENABLED=true
ATTOM_MORTGAGE_DAILY_LIMIT=10
PROPERTY_ENRICH_MAX_ATTOM_CALLS=5

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3000
# Production: APP_URL=https://parcella.com
# Comma-separated allowed CORS origins:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://parcella.com
